# RouteLab Environment Variables
# Copy this to .env.local and fill in your API keys

# Mock mode — set to "true" to use simulated responses without spending credits
# Great for demos and development!
MOCK_MODE=true

#=== Model API Keys ===
# DeepSeek (api.deepseek.com)
DEEPSEEK_API_KEY=

# OpenRouter (openrouter.ai) — used for Qwen, Llama, Gemini, Claude
OPENROUTER_API_KEY=

# NVIDIA NIM (build.nvidia.com or integrate.api.nvidia.com)
NVIDIA_API_KEY=